@Book{stra-modi,
  author           = {Elisabeth Strandberg},
  citationkey      = {stra-modi},
  date             = {1983},
  location         = {Wiesbaden},
  publisher        = {Franz Steiner Verlag},
  title            = {The Moḍī Documents from Tanjore in Danish Collections, Edited, Translated and Analysed},
  annotation       = {p.48, notes that we don't have good information on the sociolinguistics of Tanjore., \\ p.15 , the letters fall into three groups, dated from 1725--1766, 1776--1799, and 1802--1844. ``(1) the years of Tanjore's (relative) indeopendence of the British and consequent involvement with several local Indian powers as well as with the Dutch, French and British; (2) the years of Tanjore's status as a British protectyorate and (3) the period of British annexation. \\ p.11 ref to K. Rajayyan, A History of British Diplomacy in Tanjore. Mysore 1969. \\ p.12: The treaty between Raghynātha Nāyaka of Tajore and Christian IV, King of Denmark and Norway, was concluded on 19th November 1620 through the agency of the Danish admiral Ove Giedde.\footnote{L. Laursen, Trait\'es du Danemark et de la Norv\`ege. Danmark-Norges Traktater 1523--1750 med dertil h\orende aktstykker}, Bd. III. K\obenhavn 1916, nr. 23, pp. 360--6. \\ The original, written on parchment in the Portuguese language, is preserved in the Danish National Archives. It stipulated the conditions for the acquisition of Tranquebar by Denmark and the relations between the two countries. The treaty, initially valid for two years only, was prolonged, and Tranquebar together with some territories acquired later were under Danish administration until they were sold to the English East India Company in 1845. The English occupied Tranquebar from 1801 to 1802 and again from 1808 to 1815. During the dispute which the first occupation brought about between Tanjore and Denmark, it was found that the treaty kept in Tanore was lost. Together with the treaty, Raghunātha Nāyaka issued a letter of friendship incised on a plate of pure gold; this letter is also preserved in the Danish National Archives and seems to be the only extant Indian diplomatica letter of that type on gold; samples on baser metals are numerous. \ldots [p.13] During the Mar\=\d tha reign it was the practice for the hig-level correspondence between Tanjore and Tranquebar to be carried out in Marāṭh\=i and the rest in Tamil. Letters from the Danish governors to King \'Seraphoji II were in some cases writtne in English instead. \\ p.14, ref. to Surendranath Sen, The Admiistrative System of the Marathas, 2nd ed., Calcutta 1925.},
  modificationdate = {2018-09-17T00:00:00},
  owner            = {dom},
  source           = {WL Or. 2133},
}

