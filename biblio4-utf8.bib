@InCollection{elsh-2016,
  author           = {Marwa Elshakry and Carla Nappi},
  booktitle        = {A Companion to the History of Science},
  chapter          = {26},
  citationkey      = {elsh-2016},
  date             = {2016},
  location         = {Chichester},
  pages            = {372--386},
  publisher        = {John Wiley {\&} Sons, Inc.},
  title            = {Translations},
  doi              = {10.1002/9781118620762.ch26},
  abstract         = {Translation and concerns with it have had an important impact on the history and historiography of science, medicine, and technology. This chapter looks at two key turns in the historiography of science that have focused on the role of translation. It begins by tracing some of the ways in which ideas about translation shaped early histories of the “Arabic sciences” in the late nineteenth and early twentieth centuries. It then considers some of the more recent literature on translation and the history of science, focusing on antique to early modern sciences in East Asia in particular. Using these case studies, it considers a variety of historiographical, methodological, and analytical themes raised by bringing together ideas and practices of translation studies with the history of science.},
  file             = {:Lightman, B/A Companion to the History of Science - 2016 - Lightman.pdf:PDF},
  keywords         = {translation},
  modificationdate = {2024-12-12},
  month            = {3},
}

