@Article{alte-2020,
  author           = {Joseph S. Alter},
  citationkey      = {alte-2020},
  date             = {2020},
  journaltitle     = {Asian Medicine},
  number           = {1},
  pages            = {107--132},
  title            = {From Lebensreform to Swadeshi},
  volume           = {15},
  abstract         = {As an institutionalized “indigenous” system of medicine in India, nature cure derives directly from ideas and practices developed within the rubric of Lebensreform, a radi-cal, back-to-nature health reform movement that took shape in late nineteenth- and early twentieth-century  central  Europe.  Nature  cure  developed  in  twentieth-century India as a deeply embodied manifestation of Swadeshi, a social, cultural, and antico-lonial  political  movement  intimately  concerned  with  independence  and  liberation.  Significant  parallels  between  Lebensreform  and  Swadeshi  point  toward  an  under-standing  of  medicine  based  on  the  habitus  of  class  and  global  countercultural  prac-tices.  Using  examples  from  the  work  of  Adolf  Just  and  other  Germans  writing  at  the  turn of the nineteenth century and the case of Arogya Mandir, a nature cure hospital established  by  Vithal  Das  Modi  in  Gorakhpur  in  1940,  this  essay  examines  how  the  radical,  utopian  ideals  of  Lebensreform  were  translated  into  institutionalized  medi-cal practice that facilitated the embodiment of Swadeshi as a political philosophy of health reform in colonial India.},
  doi              = {10/hbtnw8},
  issn             = {1573-4218},
  creationdate     = {2022-02-22T11:54:18},
  file             = {:Alter, Joe/2020 [15734218 - Asian Medicine] From Lebensreform to Swadeshi.pdf:PDF},
