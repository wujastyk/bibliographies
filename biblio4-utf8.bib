@InCollection{shil-cent,
  author           = {Edward A. Shils},
  booktitle        = {The Constitution of Society},
  chapter          = {4},
  citationkey      = {shil-cent},
  date             = {1982},
  editor           = {Edward A. Shils},
  location         = {Chicago},
  publisher        = {University of Chicago Press},
  title            = {Center and Periphery},
  annotation       = {The essay first appeared in \emph{The Logic of Personal knowledge: essays presented to Michael Polanyi on his seventieth birthday, 11th March 1961} (London : Routledge \& Paul, 1961) Essays reprinted from the author's previous works: The intellectuals and the powers, and other essays, Center and periphery, and The calling of sociology and other essays on the pursuit of learning Includes bibliographical references contents: The integration of society -- Society and societies -- The theory of mass society -- Center and periphery -- Charisma -- Charisma, order, and status -- Deference -- The intellectuals and the powers -- Ideology -- Intellectuals and the center of society -- Tradition, ecology, and institution in the history of sociology \url{http://www.sv.ntnu.no/iss/Bjorn.Hvinden/ Has_social_policy_taken_over_sociology.htm}: ``In 1961 Edward Shils (reprinted 1982) presented one of the most explicit and clearest examples of horizontally ordered images of society. He depicted society as having a centre-periphery structure, where actors close to the centre of society were more integrated, for instance in the sense that they carried or expressed its main (``core") values, ideas and beliefs. On the other hand, he assumed that those who belonged to the periphery to less extent subscribed to, accepted or promoted such values, ideas and beliefs. He also outlined various processes of dissemination or diffusion from the centre, but also various forms of tensions between the centre and periphery. Later Johan Galtung (1964, reprinted 1974) pursued similar ideas in his work on opinions on foreign policy as a function of social position. He both contrasted the assumed typical cognitive and ideological style of those belonging to entre and periphery respectively (gradualism vs. absolutism/fundamentalism, reformism vs. radicalism/revolutionary, etc.), and developed an index of social position. Galtung eventually generalised the centre-periphery model in his work on imperialism, introducing the subdistinctions between the centre and periphery of the centre and the centre and periphery of the periphery, etc. Another follow-up can be found in Stein Rokkan�s ambitious comparative analysis of political systems (Rokkan 1999: 108--121)." Originally: Shils Edward. Centre and Periphery. In: Personal Knowledge: Essays Presented to Michael Polanyi on his Seventieth Birthday, 11 March 1961. L., 1961, p. 117, 118, 124, 128. \\ See also Shils, E. (1975). Center and periphery: Essays in macro sociology. Chicago: The University of Chicago Press.},
  edition          = {2},
  isbn             = {0226753271},
  note             = {First published in 1961},
  series           = {The Heritage of Sociology},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
}

