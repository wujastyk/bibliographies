@InCollection{karv-manu,
  author           = {C. G. Karve},
  booktitle        = {Professor P. K. Gode Commemoration Volume},
  citationkey      = {karv-manu},
  date             = {1960},
  pages            = {199--202},
  title            = {Manuscript Curatorship under the Marathas},
  annotation       = {The Peshwas had a Pustakaśālā as one of their 18 official departments. p.199: ``His [Raghunatharao Peshwa's]\ldots spouse Anandibai regularly heard Purāṇas in her widowhood at Kopergaon and once she ordered her clerk to get the official copy of Bhārata from Poona, as that copy was an authentic recension, revised from many texts of the epic. (Selections from the Peshwa Daftar, no.\,4)" I.e., Poona had a pre-critical-edition history of being the locus of the `true' Mbh. \\ p.199: \begin{quote} Raghunathrao Hari Nevalkar, the Subhedar of Jhansi from 1770 to 1794,\ldots was very desirous of gaining knowledge of these [European arts and sciences]. Mr. William Hunter, some European visitor to his place gives a casual description of his library in the following words -- ``He showed us several English books, among which was the second edition of the Encyclopaedia Britannica. Of this he had got all the plates neatly copied by artists of his own. To get at the stores of science which these volumes contain, he had, even at that advanced period of life, formed the project of studying the English language. He expressed great anxiety to procure a teacher, or any book that could facilitate his pursuit, and was highly gratified by Lieutenant M'Pherson's presenting him with a copy of Gilchrist's Dictionary." (Itihāsasaṃgraha-Aitihāsika Goṣṭhī, by Parasnis.) \par This wonderful enterpriser had also an electrical machine, constructed locally under his directions. At the same time he was very religious-minded and ended his life, when pestered with some incurable disease, by drowning himself in the Ganges at Benares.\end{quote}.\\ p.200: prices of MSS in 18 cent: Gita in 1750 was only Rs.3, MSS of Bhārata, Bhāgavata and Prapañcasāra were Rs.361, 36, and 25 respectively. Bhāratacampū, Midrārākṣasa chāyāgrantha and Śākuntala could be got in a lot for Rs.10 only. (Peshawaicyā sāvalīta, by N. G. Chapekar, pp. 177--80.).\\ p.200: scribes predominantly from Gujarat. Brahmins and Kāyasthas always wrote in Moḍī; letters of the Śāstris and Bhats were in Bālbodhi (Devanāgarī).\\ p.201: Mss were commonly lent for copying. A list of 10 title and receivers is given.\\ p.202: Pārasnis = Persian interpreter families. English and Portuguese interpreters (called Āṅgale in Goa)},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
}

