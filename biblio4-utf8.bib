@Book{atha-1980,
  citationkey      = {atha-1980},
  date             = {1980},
  editor           = {Anaṃta Dāmodara Āṭhavale},
  location         = {Puṇe},
  publisher        = {M. A. Āṭhavale, Śrı̄mad Ātreya Prakāśanam},
  title            = {\dev{aṣṭāṅgasaṅgrahaḥ śrīmadvṛddhavāgbhaṭaviracitaḥ induvyākhyāsahitaḥ} [= Vāgbhaṭa's Aṣṭāṅgasaṅgraha with Indu's Commentary]},
  Shorthand        = {As\,1980},
  eprint           = {ark:/13960/s25bwqsd0n7},
  eprinttype       = {ark},
  keywords         = {shorthand},
  comment-dom      = {Introduction, p.6: True, today the Āyurveda as an important tool in medical treatment is not shining with all its pristine glory as a result of centuries of neglect and also owing to a break in the tradition of teaching. Still the originality and the efficacy of the docrines of the Āyurveda are not negligible. The scholars are quite aware of this. Also there have been certain serious differences of opinion among the scholars as a result of a break the tradition. This results sometimes in the conmon man doubting the very scientificness itself of the Ayurveda. What is therefore badly needed is a thorough study of the basic texts of the Ayurveda and a scientific research into its fundmental and special doctrines, based on it. This alone will serve to establish the originality, the efficacy and the greatness of the Āyurveda. Unfortately, however, the present-day research into Āyurveda is far from having this ideal form. The sole aim of research into the Āyurveda today is restricted to searching out drugs for different diseases and serious symptoms mentioned in the Āyurvedic texts. Today the research in the Āyurveda has assumed a strange and unscientific form in that the diagnosis is done according to Allopathy, while the Āyurveda is resorted to in the matter of treatment. The Āyurveda has its own method of diagnosis. It is to be understood in the context of different humours (Dhātus), and impurities (Mala) and of the different bodily channels (Srotas) which serve as their seats. Similarly, while deciding on the treatment the choice of the drugs has to be made after a careful consideration of their Rasa-properties, their opposition to specific humours and their effect on the bodily channels. The research should aim at providing a scientific basis to this thought. Unfortunately it seems that this objective of research has remained completely neglected. I feel that far from being helpful to its development, this will be definitely detrimental to the Āyurveda.},
  file             = {:/home/dom/Dropbox/Digital Library extracts/Ayurveda/Astangasangraha/1980 Athavale_AshtangaSamgraha with Indu_1980.djvu:Djvu},
  modificationdate = {2021-08-25T20:05:14},
  owner            = {dom},
}

