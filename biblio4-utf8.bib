@Book{pear-port,
  author           = {Michael N. Pearson},
  citationkey      = {pear-port},
  date             = {1998},
  location         = {Baltimore},
  publisher        = {John Hopkins University Press},
  title            = {Port Cities and Intruders: The {Swahili} Coast, {India}, and {Portugal} in the Early Modern Era},
  annotation       = {A distinguished scholar of early modem Asian and European interaction in the Indian Ocean, M.N. Pearson turns his attention in the present book to East Africa and to the network of Swahili coastal societies. The work seeks to explore and define the cultural, racial, and ethnic identities of the Swahili settlements, to define their place in the broader history of the Indian Ocean prior to the arrival of the Portuguese, and to capture the changes caused by the Portuguese in the sixteenth century.\\ In more general terms, the book seeks to place the Swahili coast in the context of early modern world history, using Wallerstenian world-system theory. The world-system approach is complemented, and often greatly extended, through an analysis of spatial structures moulded in the tradition of the seminal works of K.N. Chaudhuri and other historians of the Indian Ocean inspired by the Braudel school. The purpose of the work is thus double: it seeks to present a history of the interaction between the Swahili coast, the western Indian Ocean, and the African interior; and to test the usefulness of world-system theory in positioning the Swahili civilization in a world-historical context, in the era of the emergence of mercantile capitalism and European hegemony.\\ The long introduction (29 out of the total 167 pages of text) defines the terms of discourse, outlines the theoretical framework of the topic, and offers a critique of sources. It provides a fascinating insight into the various pitfalls encountered by scholars willing to venture simultaneously into such broad, challenging, and often idiosyncratic fields as the history of Africa, India, Islam, Portugal, and the European oceanic expansion. Pearson addresses diverse methodological biases, both past and present, the issue of availability and provenance of sources, and the uneven coverage of the area under consideration.},
  modificationdate = {2018-09-17T00:00:00},
  owner            = {dom},
}

