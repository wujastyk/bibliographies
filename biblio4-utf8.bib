@Book{akas-2013b,
  author    = {Anna Ayse Akasoy},
  citationkey = {akas-2013b},
  date      = {2013},
  editor    = {Charles Burnett and Ronit Yoeli-Tlalim},
  location  = {Chicago},
  publisher = {University of Chicago Press},
  title     = {Rashīd al-Dīn: Agent and Mediator of Cultural Exchanges in Ilkhanid Iran},
  Contents  = {-- Speaking about oneself : autobiographical statements in the works of Rashīd al-Dīn / Birgitt Hoffmann -- Rashīd al-Dīn's alter ego : the seven paintings of Moses in Jāmi' al-tawārīkh / Mika Natif -- Rashīd al-Dīn's primary sources in compiling the Jāmi' al-tawārīkh : a tentative survey / Kazuhiko Shiraiwa -- The canonization of cultural memory : Ghāzān Khan, Rashīd al-Dīn, and the construction of the Mongol past / Judith Pfeiffer -- Rashīd al-Dīn as a historian of the Mamluks / Reuven Amitai -- Reappraisal of the 'register of Chiliarchies' in Jāmi' al-tawārīkh / Hodong Kim -- A tale of two doctors : Rashīd al-Dīn and Quṭb al-Dīn al-Shīrāzī / Leigh Chapman -- A comparative study of Rashīd al-Dīn's Tanksūqnāma and its Chinese sources / Vivienne Lo and Yidan Wang -- The Buddha and the straight path : Rashīd al-Dīn's Life of the Buddha : Islamic perspectives / Anna Akasoy -- Rashīd al-Dīn's Life of the Buddha : some Tibetan perspectives / Ronit Yoeli-Tlalim -- Rashīd al-Dīn's historiographical legacy in the Muslim world / Ron Sela -- Mongols, Arabs, Kurds, and Franks : Rashīd al-Dīn's comparative anthropology of tribal society / Christopher Atwood},
  isbn      = {9781908590473},
  abstract  = {Rashid al-Din (1274-1318), physician and powerful minister at the court of the Ilkhans, was a key figure in the cosmopolitan milieu in Iran under Mongol rule. He set up an area in the vicinity of the court where philosophers, doctors, astronomers, and historians from different parts of Eurasia lived together, exchanged ideas and produced books. He was himself involved in collecting, collating and editing these materials, and the substantial oeuvre that resulted is a gold-mine for anyone studying the transmission of knowledge across cultures. By bringing together contributions from the fields of the history of religion, medicine, science and art, this book examines the cultural dynamics of Rashid al-Din’s circle. It addresses questions such as: How were different or conflicting perceptions mediated? What were Rashid al-Din’s aims in gathering information about different religions and societies? To what extent does Rashid al-Din’s intellectual contribution represent something new and different from its individual components?},
}

