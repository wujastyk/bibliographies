@Article{gode-ragh,
  author           = {P. K. Gode},
  citationkey      = {gode-ragh},
  date             = {1941},
  journaltitle     = {Journal of the University of Bombay},
  number           = {2},
  pages            = {132--40},
  title            = {Raghunātha, a Prot{\'e}g{\'e} of {Queen Dīpābāi of Tanjore} and His Works -- between A.d. 1675--1712},
  volume           = {X},
  note             = {Cited from \citealt[391--403]{gode-silh2}},
  annotation       = {note 4, p.392: Ekanātha -> Āpadeva (I) -> Anantadeva (I) -> Āpadeva (II, a. of Mīmāṃsānyāyaprakāśa, AD 1600--1650) -> Anantadeva (a. of Smṛtikaustubha, AD 1675--1700). See Gode's paper on Apadeva in the FW Thomas Com. Volume, also SILH 2, ch.7, pp.39--48. \\ Ragh. says in Narakavarnana that he composed Marathi works after writing many Skt. works (p.392, note 1). He also says there that it was Dipambika who asked him to composed Marathi works for the benefit of the masses who found Sanskrit hard to understand (\emph{saṃskṛta kaṭhiṇa mhaṇūna prākṛta}). \\ In the NV, Ragh. lists his own works as 1. Bhojanakutūhala, 2. Sāhityakutūhala, 3. Prāyaścittakutūhala, 4. Janārdanamahodadhi, 5. Dharmāmṛtamahodadhi, 6. Kāśīmīmāṃsā. Before the NV, Ragh. wrote the Pativratādharma in Marathi, which includes the statement Gode, p.393, note.1: \emph{samasta janāṃsa upakāraka// hā manoṃ karūniyā viveka// pāhoniyā purāṇaśloka// bhāṣāprabaṃdha karītase}. \\ p.395: Veṅkaṭabhaṭṭa, auth. of \emph{Bhoṃsalavaṃśacarita} a contemporary of Ragh's. \\ Ref. \emph{Tanjore Gazetteer} by Hemingway, Madras 1915, p.44. \\ p.396 Raghunātha's work done between about 1676 and 1736 at latest. \\ Dipambika settled the dispute between Ekoji and half-bro Sivaji, and ``Sivaji gave her a territory of 5 lacs of \emph{hons} in appreciation of her endeavour to settle the dispute between her husband and Shivaji amicably" (Gode p.397, citing \emph{Mahārāṣṭrīya Jñānakośa}, v.\,XIV (1925), p. (ta) 4.). \\ p.398: Ragh's period between AD 1650 and 1700. \\ p.401: Ragh composed \emph{Dharmāmṛtamahodadhi} in 1701, and the \emph{Narakavarnana} after 1701 but before 1712, since he mentions all 3 of Dipabai's sons as alive. Sanskrit works, including BK, composed before \emph{Narakavarnana}.},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
  source           = {CUL 834.01.b.6.38},
}

