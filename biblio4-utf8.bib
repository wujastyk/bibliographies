  citationkey      = {garn-nouv},
  date             = {2009},
  journaltitle     = {Bulletin d’Études Indiennes},
  pages            = {107-119},
  title            = {Nouvelles Réflexions Étymologiques Autour Du Védique Sphíj},
  volume           = {24--25},
  abstract         = {ABSTRACT — Vedic sphíj- f. « hip, buttocks » (dual sphícau ) has been associated for along time with Common Germanic * spik-u- « bacon » (Modern German Speck ). Recently,this etymological linking has been carried on by J. KATZ (2006 : 157—194). Moreover, hecompares Greek φίκις ~ φίκιον « anus » by assuming a PIE etymon *sp Ì h 1 -i-K-i-, whatsoever might be the explanation of it. Concerning Vedic sphíj- , no doubt is left that thePIE underlying root was *sp Ì eh 1 - « swell » : the present paper will rather aim at throwing anew light on its morphological formation. One may assume an athematic derivative built witha velar stop such as *sp Ì(e) h 1 -k- « bulk, swelling ». Henceforth, another similar family willbe dealt with : PIE *sp Ì erh 2 -g- ~ *sp Ì reh 2 -g- « spring, burst, spatter ». This derivative of thePIE root *sp Ì erh 2 - « flicker, trampler, crush » (cf. Greek σπαίρω « gasp, pant » and Vedic SPH Ṝ - « jerk, tread underfoot » ) must be compared to the PIE collocation *sp Ì´® h 2 - d Ì eh 1 - « make a footstep, run, hurry » (Lithuanian spárdytis « kick, lash out »). The Gothic root-name * spaurds f. « running » (<*sp Ì´ ® d Ì -) is likely to reflect the univerbation of such acollocation, to which Hittite i š part- ~ i š parza- « flee, run away » eventually belongs. In theSanskrit root SP Ṛ DH- « contend » (<*« haste, hurry to victory » ?), some Vedic forms aremet with, whose vocalism is to be considered as anomalous, namely sp ū rdháse (infinitive)and sp ū rdhán (injonctive, 3rd plural). These forms may be explained as long syllabicresonants, that is a sequence of syllabic resonant plus laryngeal. The phonological treatment of Vedic sp ū rdh- (< *sp Ì´® h 2 -d Ì h 1 -V- ) would be of the same pattern as Vedic g ū rdh- « exalt »(< * ﬁ´® H- d Ì h 1 -V- « sing s.o.’s praises »)},
  eprint           = {1922530},
  eprinttype       = {academia.edu},
  issue            = {2006–2007},
  annotation       = {Notes on the etymology of sphij, buttocks bottom.},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
}

