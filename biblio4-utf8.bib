@Article{scha-rgve,
  author           = {Hartmut Scharfe},
  citationkey      = {scha-rgve},
  date             = {2016},
  journaltitle     = {Journal of the American Oriental Society},
  number           = {1},
  pages            = {47--67},
  title            = {Ṛgveda, Avesta, and Beyond -- \emph{ex Occidente Lux}?},
  volume           = {136},
  abstract         = {It is a puzzle of long standing in Indo-Iranian studies that the cognates of the Vedic devás and their eventual rivals and eternal enemies, the ásuras, have entirely opposite valuations in Old Iranian, where Ahura Mazdāh is the chief of the pantheon and the daēuuas are considered demons. This puzzle is complicated by the fact that in early Vedic the ásuras do not have the demonic role they play in later Vedic and in fact are themselves sometimes identified as devás. Numerous solutions to this problem have been advanced. This article re-examines the evidence in detail and suggests a new explanation, set in the larger Near Eastern cultural context.},
  doi              = {10.7817/jameroriesoci.136.1.47},
  issn             = {0003-0279},
  file             = {:Scharfe, Hartmut/2016 JAOS Rgveda Avesta and Beyond.pdf:PDF},
  modificationdate = {2019-01-12T00:00:00},
  publisher        = {American Oriental Society},
}

