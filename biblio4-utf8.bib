@Article{dunn-iden,
  author           = {John Dunn},
  citationkey      = {dunn-iden},
  date             = {1968},
  journaltitle     = {Philosophy},
  pages            = {85--104},
  title            = {The Identity of the History of Ideas},
  volume           = {43},
  annotation       = {86: \begin{quote} After one has chosen the aspect of a subject-matter which most concerns one, the criticisms of those whose interest in it is very different are discounted.\end{quote}\\ 88: \begin{quote} Once talking and thinking are considered seriously as social activities, it will be apparent that intellectual discussions will duly be fully understood if they are seen as complicated instances of these social activities. \end{quote}\\ 100, n.6: on historiographical thinkers who have influenced Dunn: \begin{itemize} \item R. G. Collingwood, \emph{Ideas of History} \item P. Gardiner, \emph{The Nature of Historical Explanation} \item W. Dray, \emph{Laws and Explanations in History} \item W. B. Gallie, \emph{Philosophy and the Historical Understanding} \item A. Donagan, \emph{The Later Phil. of R. G. Collingwood} \item A. Danto, \emph{Analytical Phil. of Hist.} \item \emph{Theories of Hist.} (Glencoe, Ill., 1959). \item Kuhn, \emph{SSR} \item E. Gombrich, \emph{Art and Illusion} \end{itemize}\\ 89: argues against any singular correct model of historical explanation.\\ 101, n.10: \begin{quote} Conversely, if Aristarchus thought that the earth moved aroound the sun, we can understand the notion, as expressed in these terms, without much difficulty. But we do not thereby know, or at least may not know (i.e., do not \emph{know}) what Aristarchus meant unless we know the ontological and physical contexts at the very least which gave definition to his claim. Rudely, what we know is that Aristarchus anticipated one of our more firmly established beliefs. But this is self-celebratory gibberish, not history. It is a poor attempt at understanding Aristarchus.\end{quote} 91--2: historical explanation needs two parts: a causal story (= social history) and a philosophical analysis of the ideas.\\ 92: \begin{quote}Men, breathing, excreting, hating, mocking\ldots \end{quote}\\ 103, n.18: \begin{quote}\ldots enunciated with the plummy self-assurance of a well-fed agnostic in a role which is religious only as an inconvenient historical hangover.\end{quote}\\ 98:\begin{quote}The history of philosophy, like the history of science, must needs be Whig as to subject matter, just as, like all history, it must be Tory as to truth.\end{quote} Meaning that the topics of the past selected for study must be philosophically interesting today.\\ 98: \begin{quote} The problem of interpretation is alwasy the problem of closing the context.\end{quote}},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
}

