@Book{jord-daya,
  author           = {J. T. F. Jordens},
  citationkey      = {jord-daya},
  date             = {1978},
  location         = {Delhi etc.},
  publisher        = {Oxford University Press},
  title            = {Dayānanda Sarasvatī: His Life and Ideas},
  annotation       = {pp. 28--29: \ldots [He] continued his studies of the books he had acquired. Of these he mentions four explicitly. These were two treatises on Hatha Yoga, the \emph{Hathayogapradīpikā}, a classical treatise by Svātmārāma, and the \emph{Gheranda Samhitā}, a later work. The two other works are difficult to identify. Dayananda experienced great difficulty in understanding the mystical physiology with its \emph{nārīs} and \emph{chakras}. His mind, as his later works clearly show, was inclined owards the literal, the pragmatic, the rational; and he always found it difficult to cope with the symbolic and the mythological. But he obviously tried hard. The way in which he finally cut he knot is typcial of his literal and pragmatic rationalism. This happened [in 1856] after the winter at Drona Sagar, when he reached the Ganga near Garhmukteshwar. He pulled a corpse out of the river and set to the gruesome task of cutting it up with a knife. `I then carefully examined the heart and compared it with the descriptions in the books. I did the same with the head and the neck. I came to the firm conclusion that theere was not the slightest similarity between the texts and the corpse. I then tore the books to pieces and threw them into the river with the remains of the corpse.' [Original Hindī version: \emph{Paropakārī} (Ajmer: Paropakāriṇī Sabhā) 17, no.\,5 (March 1975), p.\,12. The autobiography of Dayananda was originally published in English in the \emph{The Theosophist} 1 (Oct. 1879): 9--13, 66--8 (Cec. 1879), 2 (Nov. 1880), 24--6.]},
  modificationdate = {2018-09-17T00:00:00},
