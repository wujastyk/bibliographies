@Article{mich-2020,
  author           = {Axel Michaels},
  citationkey      = {mich-2020},
  date             = {2020},
  journaltitle     = {Contributions to Indian Sociology},
  number           = {3},
  pages            = {357--387},
  title            = {`At the Point of Confluence of Sociology and Indology': Louis Dumont's Postulate Reconsidered},
  volume           = {54},
  abstract         = {In this article, I aim to show how Louis Dumont’s famous claim that ‘the condition for a sound development of Sociology of India is found in the establishment of the proper relation between it and classical Indology’ has become obsolete and was from the beginning a problematic postulate. I first develop the historical background of the denigration of anthropological approaches in India against the rise of an idealising Indology as a philological discipline. Then I discuss the structural, methodological and ideological problems that made it difficult to follow Dumont’s advice to search for the point of confluence of sociology and Indology. Finally, I place Dumont’s holistic approach in relation to the holistic structure of academic disciplines that emerged in the 19th century on the basis of the nation-state model and argue that it is misleading and reductive to think that ‘the construction of an Indian Sociology rests in part upon the existence of Indology’.},
  doi              = {10.1177/0069966720945513},
  creationdate     = {2022-04-26T10:15:45},
  file             = {:2020 At the point of indology and sociology.pdf:PDF},
  modificationdate = {2022-04-26T10:28:00},
  publisher        = {{SAGE} Publications},
}

