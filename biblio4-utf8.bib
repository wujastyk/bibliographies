@Book{jord-2017,
  author           = {Liudmilla Jordanova},
  citationkey      = {jord-2017},
  date             = {2017},
  location         = {London},
  publisher        = {Bloomsbury Academic},
  title            = {History in Practice},
  edition          = {3},
  isbn             = {978-1780933313},
  keywords         = {historiography},
  abstract         = {How do the ways historians divide up their subject affect their work, and how have these divisions changed over the years? Why have certain fields, such as women's history and Black history, generated such intense debate about their value and validity? Is history a subject that primarily appropriates its theory from other disciplines? And what is the nature of the links between history and related disciplines, such as anthropology and literary theory? In this lively and readable study, Ludmilla Jordanova examines the many changes in the study of history in recent decades. The nature and implications of the changes remain hotly contested, and Jordanova proves a reliable guide to the emerging discipline. She looks at what historians do, how their work is used in the wider world, and how their methods are continuing to evolve. Ideal for undergraduates and general readers, the book provides an essential theoretical framework for anyone pursuing the study of history.},
  modificationdate = {2019-09-11T00:00:00},
