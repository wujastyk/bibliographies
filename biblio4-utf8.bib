@Article{lee-2019,
  author       = {Lee, W. J. and Shinde, V. and Kim, Y. J. and Jadhav, N. and Waghmare, P. and Tadav, Y. and Munshi, A. and Panyam, A. and Chatterjee, M. and Oh, C. S. and Hong, J. H. and Wilkinson, C. and Rynn, C. and Shin, D. H.},
  citationkey  = {lee-2019},
  date         = {2019},
  journaltitle = {Anatomical Science International},
  number       = {2},
  pages        = {286--292},
  title        = {Craniofacial Reconstruction of the Indus Valley Civilization Individuals Found At 4500-Year-Old Rakhigarhi Cemetery},
  volume       = {95},
  abstract     = {Despite academic efforts to study the Indus Valley Civilization (IVC), there have as yet been no successful attempts to unveil the IVC people’s craniofacial appearance. We investigated the IVC cemetery area of Rakhigarhi site, which was estimated to be of 2273 ± 38 and 2616 ± 73 years BCE. By craniofacial reconstruction (CFR) procedure using computed tomography (CT) data of two Rakhigarhi skulls (A1 BR02 and A2 BR36), we successfully reconstructed the faces of the IVC individuals who were buried about 4500 years ago. This is the first attempt to unveil scientifically accurate representations of IVC people’s actual facial morphology.},
  doi          = {10.1007/s12565-019-00504-3},
  issn         = {1447-073X},
  url          = {http://researchonline.ljmu.ac.uk/id/eprint/11497/},
