  abstract         = {Hypotheses of a Mesopotamian origin for the Vedic and Chinese star calendars are unfounded. The Yangshao culture burials discovered at Puyang in 1987 suggest that the beginnings of Chinese astronomy go back to the late fourth millennium BCE. The instructive similarities between the Chinese and Indian luni-solar calendrical astronomy and cosmology therefore with great likelihood result from convergent parallel development and not from diffusion.},
  doi              = {10.18732/H2VC7S},
  modificationdate = {2019-01-12T00:00:00},
}

