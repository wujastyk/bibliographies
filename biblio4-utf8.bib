@InCollection{maha-dhan,
  author           = {A. Krishnaswamy {Mahadick Rao Saheb}},
  citationkey      = {maha-dhan},
  date             = {1952},
  pages            = {i--xvi},
  title            = {Sarabendra Vaidyaratnavali. Maharaja Serfoji and His Dhanvantari Mahal},
  annotation       = {p.i: Serfoji knew Sanskrit, Tamil, Telugu, Urdu, and English as well as French, German, Dutch, Greek and Latin, as well as his mother tongue Marathi.\par p.xiii: He was equally a keen connoisseur of food. Not only did Rajah Serfoji dine sumptuously but he wanted his people to know the best in the art of cooking. Hence he called together the best cooks and experts in culinary art from his palace cuisine and from abroad who were proficient in South Indian, North Indian, the Mugalai (mussalmani) and European methods of preparations. Excellent recipes in those branches were ordered to be recorded in Marathi and Tamil languages for the benefit of all. Treatise on special European dishes were also translated into Indian languages and they are still preserved in his great library at Tanjore. \par A complete work embodying all the three systems of cullinary art by the name of `Sarabhendra Paka Shastra' seems to have been compiled but unfortunately we have now only an incomplete version of the same. In fact he had ordered one of his scholars Dhonda Bhatta Appa to translate in Marathi an ancient Sanskrit work called ``Bhojana Kutuhala" by one Raghunatha Suri as is seen from the half finished Marathi version available in the Library.},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
}

