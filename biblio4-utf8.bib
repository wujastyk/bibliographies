@Book{ferr-2016,
  citationkey = {ferr-2016},
  date      = {2016},
  editor    = {Fabrizio Ferrari and Thomas Dähnhardt},
  location  = {Sheffield, UK Bristol, CT},
  publisher = {Equinox},
  title     = {Roots of Wisdom, Branches of Devotion: Plant Life in South Asian Traditions},
  Contents  = {Preliminaries List of Figures [+] vii-ix Fabrizio Ferrari,Thomas Dähnhardt FREE List of Tables [+] x Fabrizio Ferrari,Thomas Dähnhardt FREE Introduction [+] xi-xxxix Fabrizio Ferrari,Thomas Dähnhardt FREE Section 1: Nature, Landscape, Devotion 1. A Modern Kalpavr̥kṣa: Sathya Sāī Bābā and the Wish-fulfilling Tree [+] 3-28 Antonio Rigopoulos £17.50 2. “Pagoda Tree”: Plants and Other Foliate Motifs on Indians Coins through History [+] 29-54 Shailendra Bhandare £17.50 3. Divine Flora, Divine Love: The Place of Natural Scenery in the Ultimate Vision of Kr̥ṣṇa Bhakti [+] 55-76 Graham M. Schweig £17.50 Section 2: Devotion, Ecology, Ritual 4. Perfumed Islam: The Culture of Scent at the Nizamuddin Basti [+] 79-97 Mikko Viitamäki £17.50 5. The Bodhi Tree and Other Plants in the Pāli Tipiṭaka [+] 98-117 Antonella Serena Comba £17.50 6. Wood, Water, and Waste: Material Aspects of Mortuary Practices in South Asia [+] 118-141 Albertina Nugteren £17.50 Section 3: Ritual, Power, Myth 7. The Herbal Arsenal and Fetid Food: The Power of Plants in Early Tantric Exorcism Rituals [+] 145-164 Michael Slouber £17.50 8. Tree-Hugger: The Sāmavedic Rite of Audumbarī [+] 165-190 Finnian M.M. Gerety £17.50 Section 4: Myth, Food, Nature 9. Caryota Urens: From Vegetable Manifestation of God to Sacred Tree of the Shamans of Odisha [+] 193-210 Stefano Beggiora £17.50 10. Rice and Rice Culture. Cultivation and Worship of a Divine Plant in Western Odisha [+] 211-240 Uwe Skoda £17.50 11. Agriculture, Floriculture and Botanical Knowledge in a Middle Bengali Text [+] 241-269 Fabrizio Ferrari £17.50 End Matter General Index [+] 270-278 Fabrizio Ferrari,Thomas Dähnhardt FREE Index of Botanical Species [+] 279-284 Fabrizio Ferrari,Thomas Dähnhardt FREE},
  isbn      = {9781781794494},
  note      = {Index of botanical species: \url{https://www.academia.edu/36827088}},
  abstract  = {Plant life has figured prominently in Indian culture. Archaeobotanical findings and Vedic texts confirm that plants have been central not only as a commodity (sources of food; materia medica; sacrificial matter; etc.) but also as powerful and enduring symbols. Roots of Wisdom, Branches of Devotion: Plant Life in South Asian Traditions explores how herbs, trees, shrubs, flowers and vegetables have been studied, classified, represented and discussed in a variety of Indian traditions such as Vedism, Hinduism, Jainism, Buddhism, indigenous cultures and Islam. Moving from an analysis of the sentience of plants in early Indian philosophies and scientific literature, the various chapters, divided in four thematic sections, explore Indian flora within devotional and mystic literature (bhakti and Sufism), mythological, ritual and sacrificial culture, folklore, medicine, perfumery, botany, floriculture and agriculture. Arboreal and floral motifs are also discussed as an expression of Indian aesthetics since early coinage to figurative arts and literary figures. Finally, the volume reflects current discourses on environmentalism and ecology as well as on the place of indigenous flora as part of an ancient yet still very much alive sacred geography.},
}

