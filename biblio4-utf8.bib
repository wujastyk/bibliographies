@Article{swee-2019,
  author       = {Will Sweetman},
  citationkey  = {swee-2019},
  date         = {2019},
  journaltitle = {Journal of the American Oriental Society},
  number       = {4},
  pages        = {781--803},
  title        = {The Absent Vedas},
  volume       = {139},
  abstract     = {The Vedas were first described by a European author in a text dating from the 1580s, which was subsequently copied by other authors and appeared in translation in most of the major European languages in the course of the seventeenth century. It was not, however, until the 1730s that copies of the Vedas were first obtained by Europeans, even though Jesuit missionaries had been collecting Indian religious texts since the 1540s. I argue that the delay owes as much to the relative absence of the Vedas in India-and hence to the greater practical significance for missionaries of other genres of religious literature-as to reluctance on the part of Brahmin scholars to transmit their texts to Europeans.},
  doi          = {10.7817/jameroriesoci.139.4.0781},
  issn         = {0003-0279},
  file         = {:Sweetman, Will/2019 JAOS The Absent Vedas.pdf:PDF},
  journal      = {Journal of the American Oriental Society},
  month        = sep,
  publisher    = {American Oriental Society},
  year         = {2021},
}

