@Article{post-2023,
  author       = {Cosimo Posth and He Yu and Ayshin Ghalichi and Hélène Rougier and Isabelle Crevecoeur and Yilei Huang and Harald Ringbauer and Adam B. Rohrlach and Kathrin Nägele and Vanessa Villalba-Mouco and Rita Radzeviciute and Tiago Ferraz and Alexander Stoessel and Rezeda Tukhbatova and Dorothée G. Drucker and Martina Lari and Alessandra Modi and Stefania Vai and Tina Saupe and Christiana L. Scheib and Giulio Catalano and Luca Pagani and Sahra Talamo and Helen Fewlass and Laurent Klaric and André Morala and Mathieu Rué and Stéphane Madelaine and Laurent Crépin and Jean-Baptiste Caverne and Emmy Bocaege and Stefano Ricci and Francesco Boschin and Priscilla Bayle and Bruno Maureille and Foni Le Brun-Ricalens and Jean-Guillaume Bordes and Gregorio Oxilia and Eugenio Bortolini and Olivier Bignon-Lau and Grégory Debout and Michel Orliac and Antoine Zazzo and Vitale Sparacello and Elisabetta Starnini and Luca Sineo and Johannes van der Plicht and Laure Pecqueur and Gildas Merceron and Géraldine Garcia and Jean-Michel Leuvrey and Coralie Bay Garcia and Asier Gómez-Olivencia and Marta Połtowicz-Bobak and Dariusz Bobak and Mona Le Luyer and Paul Storm and Claudia Hoffmann and Jacek Kabaciński and Tatiana Filimonova and Svetlana Shnaider and Natalia Berezina and Borja González-Rabanal and Manuel R. González Morales and Ana B. Marı́n-Arroyo and Belén López and Carmen Alonso-Llamazares and Annamaria Ronchitelli and Caroline Polet and Ivan Jadin and Nicolas Cauwe and Joaquim Soler and Neus Coromina and Isaac Rufı́ and Richard Cottiaux and Geoffrey Clark and Lawrence G. Straus and Marie-Anne Julien and Silvia Renhart and Dorothea Talaa and Stefano Benazzi and Matteo Romandini and Luc Amkreutz and Hervé Bocherens and Christoph Wißing and Sébastien Villotte and Javier Fernández-López de Pablo and Magdalena Gómez-Puche and Marco Aurelio Esquembre-Bebia and Pierre Bodu and Liesbeth Smits and Bénédicte Souffi and Rimantas Jankauskas and Justina Kozakaitė and Christophe Cupillard and Hartmut Benthien and Kurt Wehrberger and Ralf W. Schmitz and Susanne C. Feine and Tim Schüler and Corinne Thevenet and Dan Grigorescu and Friedrich Lüth and Andreas Kotula and Henny Piezonka and Franz Schopper and Jiřı́ Svoboda and Sandra Sázelová and Andrey Chizhevsky and Aleksandr Khokhlov and Nicholas J. Conard and Frédérique Valentin and Katerina Harvati and Patrick Semal and Bettina Jungklaus and Alexander Suvorov and Rick Schulting and Vyacheslav Moiseyev and Kristiina Mannermaa and Alexandra Buzhilova and Thomas Terberger and David Caramelli and Eveline Altena and Wolfgang Haak and Johannes Krause},
  citationkey  = {post-2023},
  date         = {2023},
  journaltitle = {Nature},
  number       = {7950},
  pages        = {117--126},
  title        = {Palaeogenomics of Upper Palaeolithic to Neolithic European Hunter-Gatherers},
  volume       = {615},
  abstract     = {Modern humans have populated Europe for more than 45,000 years1,2
. Our knowledge
of the genetic relatedness and structure of ancient hunter-gatherers is however
limited, owing to the scarceness and poor molecular preservation of human remains
from that period3
. Here we analyse 356 ancient hunter-gatherer genomes, including
new genomic data for 116 individuals from 14 countries in western and central Eurasia,
spanning between 35,000 and 5,000 years ago. We identify a genetic ancestry profile
in individuals associated with Upper Palaeolithic Gravettian assemblages from
western Europe that is distinct from contemporaneous groups related to this
archaeological culture in central and southern Europe4
, but resembles that of
preceding individuals associated with the Aurignacian culture. This ancestry profile
survived during the Last Glacial Maximum (25,000 to 19,000 years ago) in human
populations from southwestern Europe associated with the Solutrean culture, and
with the following Magdalenian culture that re-expanded northeastward after the
Last Glacial Maximum. Conversely, we reveal a genetic turnover in southern Europe
suggesting a local replacement of human groups around the time of the Last Glacial
Maximum, accompanied by a north-to-south dispersal of populations associated with
the Epigravettian culture. From at least 14,000 years ago, an ancestry related to this
culture spread from the south across the rest of Europe, largely replacing the
Magdalenian-associated gene pool. After a period of limited admixture that spanned
the beginning of the Mesolithic, we find genetic interactions between western and
eastern European hunter-gatherers, who were also characterized by marked
differences in phenotypically relevant variants.},
  doi          = {10.1038/s41586-023-05726-0},
  issn         = {1476-4687},
  file         = {:Posth, Cosimo/2023 - Palaeogenomics of Upper Palaeolithic to Neolithic European Hunter Gatherers.pdf:PDF},
  journal      = {Nature},
  month        = mar,
  publisher    = {Springer Science and Business Media {LLC}},
  year         = {2023},
}

