@Article{gang-1982,
  author           = {N. Gangadharan},
  citationkey      = {gang-1982},
  date             = {1982},
  journaltitle     = {Indian Journal of History of Science},
  number           = {1},
  pages            = {154--63},
  title            = {The State of {Āyurveda} in the Eighteenth and Nineteenth Centuries},
  volume           = {17},
  annotation       = {18th cent: Vedakavi, \emph{Jīvānandanda}; Raghunāthapaṇḍita of Campāvatī, Bombay, \emph{Vaidyavilāsa, Cikitsāmañjarī}; Mādhava Upādhyāya, from Saurāṣṭra but lived in Kāśī, and alchemist, \emph{Āyurvedaprakāśa}; \emph{Rājavallabha} a lexicon on personal hygiene, diet; \emph{Śivatattvaratnākara}, an encyclopedic work of 1709. 9 kallolas each of 108 tarangas. Anon. \emph{Yogaratnākara} (before 1746) refers to foreign Copacīnī; also, \emph{birijā, kabāb}, which are Unani terms; tobacco. \emph{Copacīnīprakāśa} composed under patronage of Ranjit Singh (1780--1839). Mir Jafar, Nawab of Bengal (1757--1762) had a personal physician named Rāmasena Kavīndramaṇi, who composed commentaries on the \emph{Rasendrasārasaṃgraha} of Gopālakṛṣṇa and \emph{Rasendracintāmaṇi} of Rāmacandra Guha. Also 18 cent: \emph{Bhaiṣayaratnāvalī} of Govindadāsa, with commentary by Narendranatha Misra of Lahore. \emph{Rājavallabhīyadravyaguṇa} by Nārāyaṇadāsa in 1760. \emph{Prayogāmṛta} by Vaidyacintāmaṇi, Nārāyaṇadāsa's pupil. \emph{Divyarasendrasāra} by Dhanapati. \emph{Vaidyāmṛta} by Nārāyaṇa.\\ 19th cent: Serfoji's Tamil \emph{Sarabhendra Vaidya murai}. \emph{Pāradakalpadruma} by Ananta (1792). \emph{Vaidyakasārasaṃgraha} by Śrīkaṇṭha Śambhu (1734). \emph{Vaidyavinoda} by Śaṅkarabhaṭṭa (1705) under patronage of King Ramsingh of Jaipur. \emph{Nighaṇṭuratnākara} by Godbole. \emph{Bṛhannighaṇṭuratnākara} by Sridattaram Chaube (both mention pineabpple, tobacco, and urine analysis; latter has English equivalents).\\ 19th century revivalists: Kaviraj Ganga Prasad Sen, Bengal. Ed. Bengali magazine \emph{Āyurveda Sañjībani}; Mahāmahopādhyāya Bejoyratha Sen (his disciple), edited Ah.; Kaviraj Hari Mohan Dasgupta and K. Kalish Chandra Sen also his disciples; K. Amritalal Gupta, wrote \emph{Āyurvedaśikṣā}, was nephew and disciple of Kalish C. Sen. MM Gananath Sen was son and disciple of Biswanath Kalpadruma of Benares. He wrote \emph{Pratyakṣaśārīra, Siddhāntanidāna} and, in Bengali, \emph{Āyurveda paricaya}, and he set up the Kalpataru Āyurvedic Works and founded the Viswanath Ayurveda Mahavidyalaya of Calcutta; Kaviraj Jyotish Chandra Saraswati of Bengal wrote a comm. on \emph{Suśrutasaṃhita} now lost; K. Jaimini Bhusan Roy founded the Aṣṭāṅga Āyurveda Vidyālaya of Calcutta; Kaviraj Gangadhar Roy = Gangadhara Kaviraj, son of Bhavani Prasad Roy of Bengal, wrote a dozen works on Ayurveda, including commentaries on the medical chapters of the \emph{Agnipurāṇa}, and on Caraka, and the \emph{Pathyāpathya, Bhāskaroaya, and Vaidyatattvaviniścaya}; had many disciples including K. Gayanath Sen of Purulia village in Birbhum district of Bengal was scholar and physician; his son K. Sitanath Sen great physician; MM Dwarakanath Sen, direct disciple of Gang.; K. Jogindranath Sen, son of Dwarkanath was scholar, wrote comm. on Caraka called \emph{Carakopāskara}; K. Parash Nath Sen of Benares also disc. of Gangadhar; K. Rajendranath Sen of Calcutta, K. Jadunath Bhattacharya of Pubna, K. Gobinda Chandra Roy of Murshidabad and K. Sricharan Sen all direct disciples of Gangadhara. K. Haran Chandra Chakraborti too, and great scholar and surgeon of ayurveda, performing Suśruta's operations, and wrote a commentary \emph{Suśrutārthasandīpan}. Zandu Bittalji Bhat, b. Kathiawad 1831, physician to Jamsaheb of Navnagar. Started a rasaśālā at Jamnagar in 1865, later shifted to Baroda and = Zandu Pharmaceuticals. HH Bhagavat Sinhji, M. of Gondal, b.1865, studied medicine at Edinburgh Univ. His book got him a Fellowhsip of the RCP, Edinburgh; Umeshachandra Datta, Chief librarian of the Govt. Skt. Coll., Calcutta, wrote \emph{Vaidyaśabdasindhu}. Shankardaji Shastry Pade, b.1867 near Pune, published Ay. magazines and convinced M. of Baroda to found an Ayurvedic college. P. S. Warrier of Kerala, b.1869, founded AVS in 1902. Jeevram Kalidas Shastry of Gujarat, founded Rasaśālā Auṣadhālaya in 1910. HH Kerala Varma (1864--1944), the Elayarāja of Cochin, tr. 2 works on toxicology into Malayalam, and compiled \emph{Viṣacikitsā} on basis of brhattrayi. Bhaskar Govind Ghanekar in his \emph{Suśrutasaṃhitā} an example of syncretist vocabulary and tr. of terms \\ Westerners: William Jones, wrote ay. articles in 1785 and 1789: \emph{The design of a treatise on the plants of India}; Richard Miller \emph{Disquisitions on the History of Medicine} (1811); H. H. Wilson ``On the medical and surgical sciences of the Hindus" (1823); Martin Honigberger, b.1795 Transylvania, court phys. to Ranjit Singh in 1829; wrote \emph{Thirty-five Years in the East} (1835); Johannes Gerhard Konig (1728--1785) from Kurtland in the Baltic, botanical and medical research; Rudolf Roth (1821--1895) studied \emph{Madanavinoda} and \emph{Carakasaṃhitā}; William Hamilton \emph{History of Medicine, Surgery and Anatomy} (1831); Ernst Haas (1835--1882); J. F. Royle, ``The antiquity and independent origin of Hindu medicine" (1837); Renouard, \emph{Medicine of the Oriental Indians} (1836), tr. by C. G. Cornegys in 1856; T. A. Wise, \emph{A Commentary on the Hindu System of Medicine} (1845); Robley Dunglison, \emph{History of Medicine from the Earliest Ages to the Commencement of the 19th Century} (1872); Hermann Bass, \emph{Outlines and Growth of the Healing Art} (1893); Edward Theodore Whithingdon, \emph{A Popular History of the Healing Art} (1894); \\ p.160: Forbes, \emph{Oriental Memoirs}, vol.\,1, po.156--7, gives an account of the Banian Hospital at Surat, ca.1750--1800, instituted to take care of injured and old animals. \\ Letter to Joseph Banks from Dr Helenus Scott on Jan 19, 1792 on the prevalance of plastic surgery in W. India: ``They practice with great success the operation of depressing the chrystalline lens when become `opake' and from time immemorial they have cut for the stone in the same place which they now do in Europe."},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
  source           = {CUL 3Front, P340.1.c.345.13},
}

