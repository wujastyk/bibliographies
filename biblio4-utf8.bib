@Article{turn-1997,
  author           = {David Turnbull},
  citationkey      = {turn-1997},
  date             = {1997},
  journaltitle     = {Futures},
  number           = {6},
  pages            = {551--562},
  title            = {Reframing Science and Other Local Knowledge Traditions},
  volume           = {29},
  abstract         = {By recognizing science as a set of local practices it becomes possible to ‘decentre’ it and develop a framework within which all knowledge systems can be equitably compared. It is argued that all knowledge traditions are spatial in that they link people, sites and skills. In order to ensure the continued existence of the diversity of knowledge traditions rather than have them absorbed into the great imperialist archive we need to enable disparate knowledge traditions to work together through the creation of a third space in which the social organization of trust can be negotiated.},
  doi              = {10.1016/S0016-3287(97)00030-X},
  url              = {https://www.academia.edu/4846560/REFRAMING_SCIENCE_AND_OTHER_LOCAL_KNOWLEDGE_TRADITIONS},
  urldate          = {2018-01-21},
  file             = {:Turnbull, David/1997 Reframing Science and other local knowledge traditions.pdf:PDF},
  modificationdate = {2019-01-12T00:00:00},
  month            = {8},
}

@InCollection{turn-rati,
  author           = {David Turnbull},
  booktitle        = {Encyclopaedia of the History of Science, Technology, and Medicine in non-{Western} Cultures},
  citationkey      = {turn-rati},
  date             = {1997},
  pages            = {845--50},
  title            = {Rationality, Objectivity, and Method},
  annotation       = {p.846: ``It is in trying to explicate rationality, objectivity, the scientific method and the nature of science that the myth of sciences's transcendental supremacy really comes undone. Rationality is a deeply problematic concept. It is profoundly embedded in the hidden assumptions of late twentieth century occidentalism about what it is to be a knowing, moral, sane individual." \\p.847: ``That [Weberian] form of rationality has a number of interwoven components, for example the acceptance of written documents as evidence as opposed to oral testimony. [cf. Indian orality, the Banyan tree = word as bond.]" ``However, at the individual level we do not behave like the ends/means optimization calculators that economic rationalism would have us believe we are. We are at least as interested in meaning, significance, and personal values as we are in economic concerns. Nor are we quite the rational agents basing our knowledge on direct experience that the legal and philosophical theorists claim. A vast preponderance of our knowledge derives not from personal experience but from books, newspapers, journals, teachers, and experts. In other words our knowledge comes, directly or indirectly, from the testimony of others, in paritcular from those we trust. Thus our individual lived rationality is based in a range of social practices, traditions and moralities that are suppressed and concealed in the portrayal of rationality as an ahistorical, universalistic form of reasoning exemplified by science."},
  doi              = {10.1007/978-1-4020-4425-0_8841},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
  source           = {WL: HI /(folios) AB/SEL},
}

@InCollection{turn-know,
  author           = {turnbull},
  booktitle        = {Encyclopaedia of the History of Science, Technology, and Medicine in non-{Western} Cultures},
  citationkey      = {turn-know},
  date             = {1997},
  pages            = {485--90},
  title            = {Knowledge Systems: Local Knowledge},
  annotation       = {Argues that knowledge systems are local, and depend upon local, socially-determined networks of agreement and cooperation. Western science is politically and economically powerful and exercises global hegemony. Yet it too is fundamentally relative, local, and only contingently authentic. Cites Geertz's \emph{Interpretation of Cultures} and thick description including that the recognition of the local embeddedness of cultural signs is essential to their understanding. Cites Bruno Latour (1986), ``Visualization and Cognition: thinking with eyes and hands", \emph{Knowledge and Society} 6:1--40. Also v. influenced by Shapin and Schaffer, \emph{Leviathan and the Air Pump}. \\ p.485: ``The sociology of scientific knowledge is one of the most classically post of all modernisms and is therefore an area in which the local is also a thematic presence which is only now coming into focus".\\ p.486: ``Perhaps the most important consequence of the recognition of the localness of scientific knowledge is that it permits a parity in the comparison of the production of contemporary technoscientific knowledge with knowledge production in other cultures. Previously the possibility of a truly equitable comparison was negated by the assumption that indigenous knowledge systems were merely local and were to be evaluated for the extent to which they had scientific characteristics ."},
  doi              = {10.1007/978-1-4020-4425-0_8705},
  modificationdate = {2019-01-12T00:00:00},
  owner            = {dom},
  source           = {WL: HI /(folios) AB/SEL},
}

