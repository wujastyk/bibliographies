sort={crape|jasmine|},
type={plants}}%
{crape jasmine}%
{Tabernaæmontana divaricata (L.) R.Br.\ ex Roem. \& Schultes. See \cite[557]{meul-plants1}, \volcite{5}[232]{avs}. Synonym of \emph{nata}. But some say Valeriana jatamansi, Jones. See  \cite[173--174]{gvdb} for discussion (and charming comments on brain-liquid testing). Some say \emph{tagara} is Indian rose-bay or Indian valerian or a Nymphoides (see \egls{kumudavatī}), but there remain many historical questions about the ancient and regional identities of this plant See, e.g., \volcite{5}[334, 345]{avs}. See also  \cite[1147]{IGP}, \volcite{1}[796, \#758]{imp}}
\glsxtrfieldlistadd{tagara}{loclist}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{14}}
