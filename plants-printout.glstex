\bibglsnewentry{kālānusārī}%
{sort={black|creeper|},
type={plants}}%
{black creeper}%
{Ichnocarpus frutescens R. Br. or Cryptolepis buchanani Roemer \& Schultes.  Probably a synonym for \emph{kṛṣṇasārivā} \citep[94--95]{gvdb}. I. frutescens has dark, rust-colored stems, so has been preferred here.  However, Cryptolepis grandiflora, Wight, also has black stems. Synonym of \emph{kālānusāriṇī, kālānusārivā}.  \emph{kālanusārya} may be a synonym of \emph{tagara}, itself hard to identify}


\bibglsnewentry{pālindī}%
