\bibglsnewentry{patra}%
{sort={malabathrum|},
type={plants}}%
{malabathrum}%
{Cinnamomum tamala, (Buch.-Ham.) Nees. See \volcite{2}[84]{avs}, \volcite{1}[\#589]{NK}.  Other common names include Indian bay leaf etc., but the plant has an ancient history in the classical world as ``malabathrum." See \cite[341]{ball-1888}, who also suggests that the chief source of the plant in India is Assam.  See also \cite{wiki-malabathrum}. \citet[581]{koko-2018} discuss the abbreviations ``leaf'' (\textgreek{φύλλα}, \emph{folium}) in the Mediterranean world that parallels the Sanskrit usage. \cite[584]{koko-2018} note that Dioscorides (fl.\,1st cent. CE) stated that malabathrum came from India, although Dioscorides' description of malabathrum is of a plant like a Nymphoides indica  (L.) Kuntze, not a tree \citep[17]{osba-dios}}


\bibglsnewentry{pattra}%
{sort={malabathrum|},
type={plants}}%
{malabathrum}%
{see \egls{patra}}


\bibglsnewentry{jīvaka}%
{sort={malaxis|orchid|},
type={plants}}%
{malaxis orchid}%
{``one of the group of eight drugs called \emph{Aṣṭavarga} about whose identity nothing definite is known'' (\gvdb{169--170}).  Identified unproblematically as Malaxis acuminata D.Don by \cite[367--370]{adps}}


\bibglsnewentry{śrīparṇī}%
{sort={Malay|beechwood|},
type={plants}}%
{Malay beechwood}%
{$\rightarrow$ \emph{kāśmarī}. Gmelina arborea Linn., \cite[412, 96--97]{gvdb}}


\bibglsnewentry{aśmantaka}%
{sort={maloo|creeper|},
type={plants}}%
{maloo creeper}%
{\citet[27]{gvdb} note that this is the name of two different drugs, Piliostigma malabaricum
(Roxb.)Benth.\  or Phanera vahlii.\ (Wight \& Arn., 1834) Benth.\ (non-lactiferous), and Ficus cordifolia Roxb.\ (lactiferous).  I have selected P. vahlii in this context because of its abundance in S. Asia and its Himalayan and Nepalese distribution}


\bibglsnewentry{nāraṅga}%
{sort={mandarin|orange|},
type={plants}}%
{mandarin orange}%
{Citrus reticulata Blanc., \gvdb{223}. Genetic studies have shown that the mandarin, as also the Citron, is one of the earliest citrus fruits and the ancestor of many other family members including sweet oranges.  Wild mandarin is one of the pure ancestral citrus taxa \citep{full-2017}.  The citron is native to south India, the east coast and the Himalayan foothils (ibid., Fig.1). The C. indica, Yu. Tanaka, or Indian Wild Orange, is indigenous to Meghalaya (idem).  \citep{wiki-2026} includes a useful diagram of genetic descent created by Chiswick Chap.}


