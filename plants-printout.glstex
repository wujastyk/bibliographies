\bibglsnewentry{agnika}%
{location={\glsnoidxdisplayloc{}{page}{glsnumberformat}{21}},
sort={wild|celery|},
type={plants}}%
{wild celery}%
{$\rightarrow$ may be \emph{bhallātaka, lāṅgalī, ajamodā, moraṭa, or agnimantha}, \cite[4]{gvdb}. Uncertain
A plant often cited in \SS, but rarely in \CS\ \citep[4]{gvdb}.  Ḍalhaṇa glossed it at
        \Su{5.2.45}{566} as \emph{ajamodā} but noted that others consider it to be \emph{moraṭa}. There is
        considerable complexity surrounding the identification of \emph{moraṭa/mūrvā} itself and related synonyms \citep[314-316]{gvdb}}
