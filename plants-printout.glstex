\bibglsnewentry{sārivā}%
{location={\glsnoidxdisplayloc{}{page}{glsnumberformat}{18}\bibglslastDelimN \glsnoidxdisplayloc{}{page}{glsnumberformat}{27}},
sort={Indian|sarsaparilla|},
