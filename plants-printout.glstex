\bibglsnewentry{tagara}%
{location={\glsnoidxdisplayloc{}{page}{glsnumberformat}{7}\bibglslastDelimN \glsnoidxdisplayloc{}{page}{glsnumberformat}{10}},
sort={crape|jasmine|},
type={plants}}%
{crape jasmine}%
{Tabernaemontana divaricata (L.) R.Br.\ ex Roem.\ \& Schultes. See \cite[557]{meul-plants1}, \volcite{5}[232]{avs}. Synonym of \gls{nata}. But some say Valeriana jatamansi, Jones. See  \cite[173--174]{gvdb} for discussion (and charming comments on brain-liquid testing). Some say \emph{tagara} is Indian rose-bay or Indian valerian, but there remain many historical questions about the ancient and regional identities of this plant See, e.g., \volcite{5}[334, 345]{avs}. See also  \cite[1147]{IGP}}
\glsxtrfieldlistadd{tagara}{loclist}{\glsnoidxdisplayloc{}{page}{glsnumberformat}{7}}
