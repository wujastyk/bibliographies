\bibglsnewentry{akṣīva}%
{sort={horseradish|tree|},
type={plants}}%
{horseradish tree}%
{see \egls{śigru}.  \gvdb{2--3, 27} discusses the contradictions in identifying this plant. I am adopting the most common traditional identification with \emph{śigru} \citep[77, note 12]{meul-2009}, although \egls{mahānimba} is also likely.   The suggestion by \citeauthor{gvdb} about the name being an erroneous reading for \emph{akṣīra[aśmantaka]} cannot stand since the name occurs in a ninth-century \SS\ manuscript.  This occurrence in the \SS\ was not known to the definitive study by \citet[77--78]{meul-2009}}


\bibglsnewentry{kṛṣṇagandhā}%
