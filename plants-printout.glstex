\bibglsnewentry{ativiṣā}%
{sort={Indian|aconite|},
type={plants}}%
{Indian aconite}%
{Aconitum ferox , Wall. ex Ser., or perhaps A. heterophyllum Wall. ex Royle, \cite[12]{gvdb}, \volcite{1}[\#39]{NK}. Also called ``atis roots'' or just \emph{viṣā}.  A. ferox is also called aconite, monkshood, wolfsbane, etc.  A. ferox is extremely poisonous. See also \egls{vatsanābha}.  It grows especially in mountainous Sikkim}


\bibglsnewentry{bhaṅgurā}%
{sort={Indian|aconite|},
type={plants}}%
{Indian aconite}%
{alternate name of \egls{ativiṣā} or \egls{priyaṅgu}, \cite[744]{moni-sans}; in SS 5.2.5, I have taken it as the former. \gvdb{288} have \emph{bhaṅgarā} as a variant of \egls{bhṛṅga}, but that is not toxic}


\bibglsnewentry{subhaṅgurā}%
{sort={Indian|aconite|},
type={plants}}%
{Indian aconite}%
{see \egls{bhaṅgurā}, it's usual form, without the prefix \emph{su-}  “good”}


\bibglsnewentry{vatsanābha}%
{sort={Indian|aconite|},
type={plants}}%
{Indian aconite}%
{Aconitum ferox, Wall. ex Ser. Cf.\ \volcite{1}[47]{avs} (A. Napellus, L., wolfsbane, is European and now taxonomically separated from A. ferox), \volcite{1}[\#42]{NK}, \cite[4\,f]{potter}.  A. chasmanthum Stapf ex Holmes according to \cite[357]{gvdb}, but that is distributed in Pakistan, Afghanistan and Tibet, Mongolia and Siberia.  "\emph{vatsanābha}" occurs in only once in the \CS\ and thrice in the \SS\ (\Ca{4.23.11}{571}, \Su{5.2.5, 6, 12}{564})}


