  kogi, koki}, meaning ``small, little, young'' \cite[2030]{DED}.  This is possibly 
  supported by Kannada \emph{kok} and Telugu \emph{golatta, koku} for the 
  mole-rat, reported by \citet[205]{bia}},
  Name        = {mole-rat},
}

@Entry{mahākapila,
