}

@Entry{pṛṣata,
  citationkey = {pṛṣata},
  description = {Axis axis, Erxleben.  \cite[295--296]{bia}.   In \SS\ \Su{5.5.71}{579} it seems to be specifically the musk that is meant.  so the reference may be to the Musk Deer (Moschus moschiferus L.).  But all species produce musk, so \emph{pṛṣata} may also be simply Chital or Spotted Deer. See also \cite[93]{IW}},
  name        = {chital deer},
  plural      = {chital deer},
}

@Entry{cilicima,
