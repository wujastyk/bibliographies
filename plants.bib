@Entry{kālakūṭā,
  Description = {possibly Abrus precatorius, L. See  \volcite{1}[10]{avs}, \volcite{1}[\#6]{NK}, \cite[168]{potter}. 
Jequirity contains a dangerous toxin called Abrin in its seeds and to a lesser extent in its leaves, 
but apparently not in its roots or bulb. Abrin is not harmful if eaten, 
but an infusion of the bruised (not boiled)  seeds injected or rubbed in the eyes can be fatal \citep[\#
    6]{NK}.  The dose can be quite small.  
The Nepalese witnesses agree
on the feminine form, \emph{kālakūṭā}, while the more normal gender is masculine. 
The etymology of the name \emph{kāla-kūṭa}, ``black-top," fits with the striking 
  appearance of jequirity seeds.  \gvdb{93} does not attempt to identify the 
  plant.  The \emph{Rasaratnasamuccaya} of pseudo-Vāgbhaṭa (21.14) says 
  that the \emph{kālakūṭa} poison is similar to ``crow's beak'' 
  (\emph{kākacañcu}), which is a more certain name for jequirity.   
        The \emph{Rāja\-nighaṇṭu\-pariśiṣṭa} (9.35) gives \emph{kālakūṭaka} 
 as a synonym for \emph{kāras\-kara}, or \emph{Strychnos nux-vomica}, L., 
        whose seeds are notoriously poisonous. 
Another 
  hypothesis for the name, which could be translated ``time/death-peak'' 
  might connect it with Sandakphu mountain, whose name is Lepcha for ``the 
  height of the poisonous plant'' because of the abundance of Aconitum ferox 
  on the mountain},
  Name        = {jequirity},
  citationkey = {kālakūṭā},
}

