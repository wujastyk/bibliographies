@Entry{kālakūṭā,
  citationkey = {kālakūṭā},
  description = {possibly Abrus precatorius, L. Cf.\ RRS 21.14. See 
  \volcite{1}[10]{avs}, \volcite{1}[\#6]{NK}, \cite[168]{potter}. The Nepalese witnesses agree
on the feminine form, \emph{kālakūṭā}, while the more normal gender is masculine. 
The etymology of the name \emph{kāla-kūṭa}, ``black-top," fits with the striking 
  appearance of jequirity seeds.  \gvdb{93} does not attempt to identify the 
  plant.  The \emph{Rasaratnasamuccaya} of pseudo-Vāgbhaṭa (21.14) says 
  that the \emph{kālakūṭa} poison is similar to ``crow's beak'' 
  (\emph{kākacañcu}), which is a more certain name for jequirity.   Another 
  hypothesis for the name, which could be translated ``time/death-peak'' 
  might connect it with Sandakphu mountain, whose name is Lepcha for ``the 
  height of the poisonous plant'' because of the abundance of Aconitum ferox 
  on the mountain},
  name        = {jequirity},
}

